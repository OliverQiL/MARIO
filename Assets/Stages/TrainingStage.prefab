  steps:
  - title: JUMP!
    hint: Jump under the ? block to hit it
    actions:
    - jump
    station: {fileID: 730581209498989087}
    kind: 0
    rounds: 3
    needsFlower: 0
    removeFlower: 0
  - title: PUNCH!
    hint: Punch the brick in front of you
    actions:
    - punch
    station: {fileID: 5813088706497002696}
    kind: 1
    rounds: 3
    needsFlower: 0
    removeFlower: 0
  - title: STOMP!
    hint: Wait for the Goomba, stomp it at your feet
    actions:
    - stomp
    station: {fileID: 8301206828663624841}
    kind: 2
    rounds: 3
    needsFlower: 0
    removeFlower: 0
  - title: SQUAT!
    hint: Squat when the cannon glows to duck the Bullet Bill
    actions:
    - squat
    station: {fileID: 2816362051949728538}
    kind: 3
    rounds: 3
    needsFlower: 0
    removeFlower: 0
  - title: THROW!
    hint: Throw a fireball at the Goomba
    actions:
    - throw
    station: {fileID: 7318073719300628791}
    kind: 4
    rounds: 3
    needsFlower: 1
    removeFlower: 0
  - title: STOMP, CLAP, THROW!
    hint: Stomp the Koopa, clap to grab its shell, then throw it at a Goomba
    actions:
    - stomp
    - clap
    - throw
    station: {fileID: 6893776935722757830}
    kind: 5
    rounds: 3
    needsFlower: 0
    removeFlower: 1
  - title: JUMP AT THE FLAG!
    hint: Walk to the flag and jump to grab it
    actions:
    - jump
    station: {fileID: 7259662619348916011}
    kind: 6
    rounds: 1
    needsFlower: 0
    removeFlower: 0
